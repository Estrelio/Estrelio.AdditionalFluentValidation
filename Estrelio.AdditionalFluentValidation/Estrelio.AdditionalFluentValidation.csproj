<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>Estrelio.AdditionalFluentValidation</PackageId>
        <version>0.0.11</version>
        <authors>TabooSun</authors>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>Contains additional FluentValidation rules</Description>
    </PropertyGroup>

    <PropertyGroup>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Estrelio.Linter" Version="0.0.6">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="FluentValidation" Version="12.0.0" />
        <PackageReference Include="libphonenumber-csharp" Version="9.0.6" />
        <PackageReference Include="Grpc.StatusProto" Version="2.71.0"/>
    </ItemGroup>
</Project>
